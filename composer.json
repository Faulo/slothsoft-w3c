{
    "name": "slothsoft/w3c",
    "description": "A Farah module that contains interfaces for various w3c specs.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34"
    },
    "autoload": {
        "psr-4": {
            "w3c\\": "src"
        }
    },
    "keywords": [
        "slothsoft",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "w3c\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-w3c/",
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
